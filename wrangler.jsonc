{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "my-budget-pc",
	"main": "worker.ts",
	"compatibility_date": "2026-09-30",
	"workers_dev": true,
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"run_worker_first": ["/api", "/api/*"],
		"not_found_handling": "single-page-application"
	}
}